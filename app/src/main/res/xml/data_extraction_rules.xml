<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jarvis_secure_keys.xml" />
        <exclude domain="sharedpref" path="jarvis_legacy_keys.xml" />
        <exclude domain="file" path="datastore/jarvis_preferences.preferences_pb" />
        <exclude domain="file" path="sentry_captures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jarvis_secure_keys.xml" />
        <exclude domain="sharedpref" path="jarvis_legacy_keys.xml" />
        <exclude domain="file" path="sentry_captures/" />
    </device-transfer>
</data-extraction-rules>
